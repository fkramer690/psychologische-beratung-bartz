---
/**
 * Aufklappbare Fragen. Antworten dürfen einfaches HTML enthalten (Links).
 * Für die strukturierten Daten wird das HTML automatisch entfernt.
 */
interface Props {
  fragen: { frage: string; antwort: string }[];
}
const { fragen } = Astro.props;
---

<div class="faq">
  {
    fragen.map((f) => (
      <details class="faq__eintrag">
        <summary>
          <h3>{f.frage}</h3>
        </summary>
        <div class="faq__antwort" set:html={f.antwort} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--sand);
  }
  .faq__eintrag {
    border-bottom: 1px solid var(--sand);
  }
  summary {
    position: relative;
    list-style: none;
    cursor: pointer;
    padding: 1.15rem 2.75rem 1.15rem 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  summary::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 2px solid var(--taupe);
    border-bottom: 2px solid var(--taupe);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 0.2s;
  }
  details[open] summary::after {
    transform: translateY(-30%) rotate(-135deg);
  }
  .faq__antwort {
    padding: 0 0 1.25rem;
    max-width: var(--breite-text);
  }
  .faq__antwort :global(p:last-child) {
    margin-bottom: 0;
  }
</style>

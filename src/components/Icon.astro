---
// Linien-Icons im Corporate Design: 24er-Raster, Strich 1,6, runde Enden,
// Farbe über currentColor (Standard Taupe). Rein dekorativ (aria-hidden),
// die Bedeutung steht immer im Text daneben.
//
// <Icon name="gespraech" />             nur das Icon
// <Icon name="gespraech" kreis />       Icon in einer ruhigen Kreisfläche

const icons = {
  // Angebote und Formate
  gespraech:
    '<path d="M3.5 6.5A2.5 2.5 0 0 1 6 4h7a2.5 2.5 0 0 1 2.5 2.5V10a2.5 2.5 0 0 1-2.5 2.5H8.5L5.5 15v-2.6A2.5 2.5 0 0 1 3.5 10z"/><path d="M18.5 8.5a2 2 0 0 1 2 2V14a2 2 0 0 1-2 2v2.5L15.5 16H12a2 2 0 0 1-2-1.8"/>',
  system:
    '<circle cx="12" cy="11.5" r="2.6"/><circle cx="5" cy="5.5" r="1.8"/><circle cx="19" cy="6" r="1.8"/><circle cx="5.5" cy="18.5" r="1.8"/><circle cx="18.5" cy="18" r="1.8"/><path d="M10.1 9.7 6.3 6.7M13.9 9.8l3.7-2.7M10.2 13.4l-3.4 3.8M13.8 13.4l3.4 3.3"/>',
  weg:
    '<g transform="rotate(-12 8 15)"><ellipse cx="8" cy="12.6" rx="2.6" ry="3.7"/><ellipse cx="8.2" cy="19.2" rx="1.9" ry="1.7"/></g><g transform="rotate(12 16 8)"><ellipse cx="16" cy="5.8" rx="2.6" ry="3.7"/><ellipse cx="16.2" cy="12.4" rx="1.9" ry="1.7"/></g>',
  online:
    '<rect x="4" y="4.5" width="16" height="11" rx="1.5"/><path d="M2.5 19h19"/><circle cx="12" cy="8.6" r="1.7"/><path d="M9 13.2c.6-1.3 1.7-2 3-2s2.4.7 3 2"/>',
  praxis:
    '<path d="M6 20.5V4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5v16M3.5 20.5h17"/><circle cx="15" cy="12.5" r=".7" fill="currentColor" stroke="none"/>',
  weiher:
    '<path d="M3 15.5c1.5-1.1 3-1.1 4.5 0s3 1.1 4.5 0 3-1.1 4.5 0 3 1.1 4.5 0M3 19.5c1.5-1.1 3-1.1 4.5 0s3 1.1 4.5 0 3-1.1 4.5 0 3 1.1 4.5 0"/><path d="M15.5 3.5a3 3 0 0 1 3 3c0 1.7-1.3 3-3 3s-3-1.3-3-3a3 3 0 0 1 3-3zM15.5 9.5V12"/>',

  // Auf einen Blick
  stufen: '<path d="M3.5 20H8v-4.5h4.5V11H17V6.5h3.5"/>',
  ort: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
  tasse:
    '<path d="M5 9.5h11V14a4.5 4.5 0 0 1-4.5 4.5h-2A4.5 4.5 0 0 1 5 14z"/><path d="M16 11h1.3a2.3 2.3 0 0 1 0 4.6H16M8.5 3.8c-.8 1 .8 2 0 3M12.5 3.8c-.8 1 .8 2 0 3M4 21h13"/>',
  schloss:
    '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5v-3a4 4 0 0 1 8 0v3M12 14.5v2.2"/>',

  // Ablauf
  nachricht: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.6 7.2 8.4 6 8.4-6"/>',
  kennenlernen:
    '<circle cx="7.5" cy="8.5" r="2.6"/><circle cx="16.5" cy="8.5" r="2.6"/><path d="M3 19.5c0-3 2-5.2 4.5-5.2s4.5 2.2 4.5 5.2M12 19.5c0-3 2-5.2 4.5-5.2s4.5 2.2 4.5 5.2"/>',
  bezahlung: '<rect x="3" y="6" width="18" height="12.5" rx="2"/><path d="M3 10.2h18M7 14.6h3.5"/>',
  kalender:
    '<rect x="4" y="5.5" width="16" height="15" rx="2"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4M10 13.6l4 4M14 13.6l-4 4"/>',
  dokument:
    '<path d="M14 3.5H7.5A1.5 1.5 0 0 0 6 5v14a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 18 19V7.5z"/><path d="M14 3.5v4h4M9 12h6M9 15.5h4"/>',

  // Haltung
  ruhig:
    '<path d="M3 10c1.5-1.1 3-1.1 4.5 0s3 1.1 4.5 0 3-1.1 4.5 0 3 1.1 4.5 0M3 15c1.5-1.1 3-1.1 4.5 0s3 1.1 4.5 0 3-1.1 4.5 0 3 1.1 4.5 0"/>',
  struktur: '<path d="M9.5 7h10.5M9.5 12h10.5M9.5 17h10.5"/><circle cx="5" cy="7" r="1.1"/><circle cx="5" cy="12" r="1.1"/><circle cx="5" cy="17" r="1.1"/>',
  herz: '<path d="M12 19.5s-7.5-4.5-7.5-10A4.2 4.2 0 0 1 12 7.2a4.2 4.2 0 0 1 7.5 2.3c0 5.5-7.5 10-7.5 10z"/>',
  augenhoehe:
    '<circle cx="7.5" cy="8" r="2.6"/><circle cx="16.5" cy="8" r="2.6"/><path d="M3 19c0-3 2-5.2 4.5-5.2S12 16 12 19M12 19c0-3 2-5.2 4.5-5.2S21 16 21 19M10.4 8h3.2"/>',
} as const;

type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  kreis?: boolean;
  class?: string;
}
const { name, kreis = false, class: klasse = '' } = Astro.props;
const svg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${icons[name]}</svg>`;
---

{
  kreis ? (
    <span class:list={['icon-kreis', klasse]} set:html={svg} />
  ) : (
    <span class:list={['icon', klasse]} set:html={svg} />
  )
}

---
import { nav } from '../config/site';

const pfad = Astro.url.pathname;
const aktiv = (href: string) => pfad === href || (href !== '/' && pfad.startsWith(href));
---

<header class="kopf">
  <div class="container kopf__innen">
    <a class="kopf__logo" href="/" aria-label="Lea Bartz, Psychologische Beratung Aachen – zur Startseite">
      <img
        src="/brand/lea-bartz-logo-quer-farbig.svg"
        alt="Lea Bartz – Psychologische Beratung Aachen"
        width="212"
        height="60"
        fetchpriority="high"
      />
    </a>

    <nav class="kopf__nav" aria-label="Hauptnavigation">
      <input type="checkbox" id="menue" class="kopf__toggle sr-only" aria-controls="hauptmenue" />
      <label for="menue" class="kopf__burger">
        <span class="sr-only">Menü öffnen oder schließen</span>
        <span aria-hidden="true"></span>
      </label>
      <ul id="hauptmenue" class="kopf__liste">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="kopf__cta">
          <a class="button" href="/kontakt/">Erstgespräch vereinbaren</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .kopf {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 249, 246, 0.94);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--sand-hell);
  }
  .kopf__innen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .kopf__logo img {
    width: auto;
    height: 46px;
  }
  .kopf__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .kopf__liste a:not(.button) {
    font-family: var(--schrift-titel);
    font-weight: 500;
    font-size: 1rem;
    color: var(--tinte);
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1.5px solid transparent;
  }
  .kopf__liste a:not(.button):hover,
  .kopf__liste a[aria-current='page'] {
    border-color: var(--taupe);
  }
  .kopf__cta .button {
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
  }
  .kopf__burger {
    display: none;
  }

  @media (max-width: 60rem) {
    .kopf__logo img {
      height: 40px;
    }
    .kopf__burger {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      cursor: pointer;
      border-radius: var(--radius);
    }
    .kopf__burger span[aria-hidden],
    .kopf__burger span[aria-hidden]::before,
    .kopf__burger span[aria-hidden]::after {
      display: block;
      width: 1.4rem;
      height: 2px;
      background: var(--tinte);
      border-radius: 2px;
      transition: transform 0.2s;
    }
    .kopf__burger span[aria-hidden] {
      position: relative;
    }
    .kopf__burger span[aria-hidden]::before,
    .kopf__burger span[aria-hidden]::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .kopf__burger span[aria-hidden]::before {
      top: -7px;
    }
    .kopf__burger span[aria-hidden]::after {
      top: 7px;
    }
    .kopf__toggle:focus-visible + .kopf__burger {
      outline: 2px solid var(--schiefer);
    }
    .kopf__toggle:checked + .kopf__burger span[aria-hidden] {
      background: transparent;
    }
    .kopf__toggle:checked + .kopf__burger span[aria-hidden]::before {
      transform: translateY(7px) rotate(45deg);
    }
    .kopf__toggle:checked + .kopf__burger span[aria-hidden]::after {
      transform: translateY(-7px) rotate(-45deg);
    }
    .kopf__liste {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--rand) 1.5rem;
      background: var(--papier);
      border-bottom: 1px solid var(--sand-hell);
      box-shadow: 0 12px 24px rgba(18, 16, 13, 0.06);
    }
    .kopf__toggle:checked ~ .kopf__liste {
      display: flex;
    }
    .kopf__liste li a:not(.button) {
      display: block;
      padding: 0.85rem 0;
      font-size: 1.15rem;
      border-bottom: 1px solid var(--sand-hell);
    }
    .kopf__cta {
      margin-top: 1.25rem;
    }
    .kopf__cta .button {
      width: 100%;
      min-height: 3rem;
    }
  }
</style>

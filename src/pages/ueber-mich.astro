---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Todo from '../components/Todo.astro';
import { site } from '../config/site';

import fotoPortraet from '../assets/fotos/lea-bartz-portraet.jpg';
import fotoPraxis from '../assets/fotos/gespraech-praxis.jpg';

const werte = [
  { titel: 'Ruhig', text: 'Du bekommst Zeit und Raum. Kein Druck, keine schnellen Lösungen.' },
  { titel: 'Strukturiert', text: 'Wir arbeiten klar und nachvollziehbar, mit einer Zusammenfassung nach jeder Sitzung.' },
  { titel: 'Wertschätzend', text: 'Ich bewerte nicht, sondern interessiere mich ehrlich für dich und deine Sicht.' },
  { titel: 'Auf Augenhöhe', text: 'Du bist Expertin oder Experte für dein Leben. Ich begleite dich auf deinem Weg.' },
];
---

<Base
  title="Lea Bartz – psychologische Beraterin in Aachen"
  description="Lea Bartz verbindet über 15 Jahre Erfahrung in People & Culture mit psychologischer und systemischer Beratung in Aachen. Lerne mich im Erstgespräch kennen."
  breadcrumbs={[{ name: 'Über mich', href: '/ueber-mich/' }]}
  ogImage="/lea-bartz.jpg"
>
  <section class="section boegen kopfbereich">
    <div class="container grid-2">
      <div>
        <span class="eyebrow">Über mich</span>
        <h1>Hallo, ich bin Lea Bartz</h1>
        <p class="lead">
          Psychologische und systemische Beraterin in Aachen, mit über 15 Jahren Erfahrung in der Arbeit mit Menschen
          im Bereich People &amp; Culture.
        </p>
        <p>
          Menschen und ihre Geschichten haben mich schon immer berührt. In meiner langjährigen Arbeit im Bereich People
          &amp; Culture durfte ich viele unterschiedliche Persönlichkeiten kennenlernen, begleiten und in
          herausfordernden Situationen unterstützen. Mit der Zeit wurde mir bewusst, dass mich vor allem das
          interessiert, was hinter Rollen, Erwartungen und Strukturen liegt: der Mensch selbst, mit seinen Gedanken,
          Gefühlen, Beziehungen und inneren Beweggründen.
        </p>
      </div>
      <Image
        src={fotoPortraet}
        alt="Porträt von Lea Bartz, lächelnd, im Hintergrund unscharf die Stadt"
        widths={[400, 600, 790]}
        sizes="(min-width: 52rem) 30rem, 100vw"
        class="foto portraet"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section section--hell">
    <div class="container text">
      <h2>Mein Weg in die Beratung</h2>
      <p>
        Ein wichtiger Wendepunkt war eine eigene systemische Beratung, die ich vor einigen Jahren in Anspruch genommen
        habe. Sie hat mir gezeigt, wie kraftvoll es sein kann, wenn jemand mit einem klaren, wertschätzenden Blick
        begleitet: ohne zu bewerten, ohne zu drängen, mit echtem Interesse am Menschen. Sie hat mir den Mut gegeben,
        Veränderungen anzugehen und meinen beruflichen Weg neu auszurichten.
      </p>
      <p>
        Dieser Wunsch, tiefer hinzuschauen, hat mich zu spezialisierten Weiterbildungen in psychologischer und
        systemischer Beratung geführt. Heute verbinde ich meine Erfahrung aus der Arbeit mit Menschen mit fundierten
        psychologischen Methoden.
      </p>
      <blockquote class="zitat">
        Es geht nicht immer nur um ein „weg von“, sondern genauso um ein „hin zu“.
      </blockquote>
      <p>
        Psychologische Beratung ist für mich weit mehr als ein Weg aus Überforderung oder Belastung, auch wenn das ein
        wichtiger Teil sein kann. Sie ist genauso sinnvoll, wenn du dich weiterentwickeln, Ziele erreichen oder mehr
        Klarheit über deine Wünsche und Potenziale gewinnen möchtest.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2" style="align-items:start">
      <div>
        <span class="eyebrow">Qualifikation</span>
        <h2>Ausbildung und Erfahrung</h2>
        <ul class="haken">
          <li>Über 15 Jahre Erfahrung im Bereich People &amp; Culture</li>
          {
            site.qualifikationen ? (
              site.qualifikationen.map((q) => <li>{q}</li>)
            ) : (
              <>
                <li><Todo was="Weiterbildung psychologische Beratung: Institut, Umfang, Jahr" /></li>
                <li><Todo was="Weiterbildung systemische Beratung: Institut, Umfang, Jahr" /></li>
                <li><Todo was="Verbandsmitgliedschaft, z. B. DGSF, SG oder VFP (falls vorhanden)" /></li>
              </>
            )
          }
        </ul>
      </div>
      <div>
        <span class="eyebrow">Haltung</span>
        <h2>Wie ich arbeite</h2>
        <div class="werte">
          {
            werte.map((w) => (
              <div>
                <h3>{w.titel}</h3>
                <p>{w.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container grid-2 grid-2--bild-links">
      <div>
        <span class="eyebrow">Die Praxis</span>
        <h2>Ein ruhiger Raum in Burtscheid</h2>
        <p>
          Meine Praxis liegt in der {site.adresse.strasse} in Aachen-Burtscheid. Ein Luftreiniger sorgt für angenehme
          Raumluft. Mein Hund ist während der Beratung nicht in den Räumen, also auch für Allergiker:innen gut
          geeignet. Die Räume sind über Treppen erreichbar und leider nicht barrierefrei; dann sprechen wir gern online
          oder beim Walk &amp; Talk.
        </p>
        <p>
          Bei mir ist jede und jeder willkommen, unabhängig von Herkunft, Identität, Lebensform oder persönlicher
          Geschichte.
        </p>
      </div>
      <Image
        src={fotoPraxis}
        alt="Lea Bartz sitzt im Sessel und spricht mit einer Klientin in ihrer Praxis"
        widths={[420, 640, 954]}
        sizes="(min-width: 52rem) 34rem, 100vw"
        class="foto"
      />
    </div>
  </section>

  <CtaBand titel="Ich freue mich darauf, dich kennenzulernen" text="In meiner Praxis in Aachen, online oder beim Walk & Talk: Im kostenlosen Erstgespräch finden wir heraus, was zu dir passt." />
</Base>

<style>
  .kopfbereich {
    background: linear-gradient(180deg, var(--sand-hell) 0%, var(--papier) 100%);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .portraet {
    aspect-ratio: 5 / 6;
    max-height: 34rem;
  }
  .zitat {
    margin: 2rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    border-left: 3px solid var(--taupe);
    font-family: var(--schrift-titel);
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.35;
    color: var(--taupe-dunkel);
  }
  .werte {
    display: grid;
    gap: 0.25rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .werte h3 {
    margin-bottom: 0.25rem;
  }
</style>

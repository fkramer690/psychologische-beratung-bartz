# Apache-Konfiguration für IONOS-Webhosting (oder jeden anderen Apache-Server)

Options -Indexes
ErrorDocument 404 /404.html
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer https und www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.psychologische-beratung-bartz.de%{REQUEST_URI} [L,R=301]

  # Alte Adressen der Baukasten-Seite
  RewriteRule ^faq-1/?$ /faq/ [L,R=301]
  RewriteRule ^wp-sitemap.*\.xml$ /sitemap-index.xml [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Dateien mit Hash im Namen dürfen lange gecacht werden
  <FilesMatch "^.*\.[A-Za-z0-9_-]{8,}\.(js|css|webp|avif|jpg|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml text/plain application/manifest+json
</IfModule>
